<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- QEMU's HVF accelerator needs this entitlement; the player hosts QEMU
         in-process, so it is the binary that must carry it. Same key QEMU
         upstream ships in accel/hvf/entitlements.plist. -->
    <key>com.apple.security.hypervisor</key>
    <true/>
</dict>
</plist>
