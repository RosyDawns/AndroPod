# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# SwiftPM / 构建产物
.build/
app/build/

# 运行时数据:镜像与实例都是大二进制,不入库
# (Alpine 测试镜像用 ./bin/andropod fetch 下载;安卓镜像从 release 页下载,见 README)
runtime/images/*
runtime/instances/*
!runtime/images/.gitkeep
!runtime/instances/.gitkeep

# 二进制运行时产物(安全网)
*.qcow2
*.fd
*.ppm
*.pid
*.sock
*.log

# QEMU 源码树与压缩包（1.8G，第三方上游；获取方式见 docs/08 与 third_party/*
!third_party/README.md
!third_party/cocoa.mREADME）
third_party/*
!third_party/README.md
!third_party/cocoa.m

# 引擎构建产物（engine/embed/build_libqemu.sh 重新生成）
engine/embed/libandropod-qemu.dylib
engine/embed/player

# 桌面 APK 的构建产物与本地签名密钥（build-apk.sh 重新生成）
app/home-apk/out/
app/home-apk/debug.keystore
app/home-apk/*.p12

# 运行时临时文件
runtime/instances/*/
*.png.orig
*.o.tmp
